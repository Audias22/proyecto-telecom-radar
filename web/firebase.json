{
  "database": {
    "rules": "database.rules.json"
  },
  "hosting": {
    "public": "panel",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "config.ejemplo.js",
      "README.md"
    ],
    "headers": [
      {
        "source": "**/*.@(html|js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  },
  "emulators": {
    "database": {
      "port": 9000
    },
    "auth": {
      "port": 9099
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true
    }
  }
}
