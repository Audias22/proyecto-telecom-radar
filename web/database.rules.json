{
  "rules": {
    ".read": false,
    ".write": false,

    "dispositivos": {
      ".read": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true",
      "$baseId": {
        ".read": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).val() === $baseId",
        "estado": {
          ".write": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).val() === $baseId",
          ".validate": "newData.hasChildren(['online', 'ultimo_contacto'])",
          "online": { ".validate": "newData.isBoolean()" },
          "ultimo_contacto": { ".validate": "newData.isNumber() && newData.val() === now" },
          "rssi_wifi": { ".validate": "newData.isNumber() && newData.val() >= -127 && newData.val() <= 0" },
          "version_firmware": { ".validate": "newData.isString() && newData.val().length <= 32" },
          "$otro": { ".validate": false }
        }
      }
    },

    "colgantes": {
      ".read": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true",
      "$colganteId": {
        ".write": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).exists()",
        ".validate": "$colganteId.matches(/^[0-9]{1,3}$/) && newData.hasChildren(['bateria_mv', 'ultimo_heartbeat'])",
        "bateria_mv": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5000" },
        "ultimo_heartbeat": { ".validate": "newData.isNumber() && newData.val() === now" },
        "rssi": { ".validate": "newData.isNumber() && newData.val() >= -127 && newData.val() <= 0" },
        "base": { ".validate": "newData.isString() && newData.val() === root.child('cuentas_dispositivo').child(auth.uid).val()" },
        "$otro": { ".validate": false }
      }
    },

    "lecturas": {
      ".read": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true",
      "$baseId": {
        ".read": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).val() === $baseId",
        ".write": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).val() === $baseId",
        ".validate": "newData.hasChildren()",
        "$ts": {
          ".validate": "$ts.matches(/^[0-9]{13}$/) && newData.hasChildren(['persona', 'objetivo']) && (newData.child('persona').val() === false || newData.child('objetivo').val() === true)",
          "persona": { ".validate": "newData.isBoolean()" },
          "objetivo": { ".validate": "newData.isBoolean()" },
          "actividad": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
          "distancia_cm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
          "resp_rpm": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 60" },
          "latido_bpm": { ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 250" },
          "diferida": { ".validate": "newData.isBoolean()" },
          "$otro": { ".validate": false }
        }
      }
    },

    "eventos": {
      ".read": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true",
      ".indexOn": ["timestamp", "atendido"],
      "$eventoId": {
        ".write": "auth != null && root.child('cuentas_dispositivo').child(auth.uid).exists() && !data.exists()",
        ".validate": "newData.hasChildren(['tipo', 'origen', 'timestamp', 'atendido'])",
        "tipo": { ".validate": "newData.isString() && newData.val().matches(/^(BOTON|BATERIA_BAJA|BASE_DESCONECTADA|COLGANTE_AUSENTE|RADAR_SIN_DATOS)$/)" },
        "origen": { ".validate": "newData.isString() && (newData.val() === root.child('cuentas_dispositivo').child(auth.uid).val() || newData.val().matches(/^colgante[0-9]{1,3}$/))" },
        "timestamp": { ".validate": "newData.isNumber() && newData.val() === now" },
        "detalle": { ".validate": "newData.isString() && newData.val().length <= 200" },
        "atendido": {
          ".write": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true && data.exists()",
          ".validate": "newData.isBoolean() && ((data.exists() && newData.val() === true) || (!data.exists() && newData.val() === false))"
        },
        "atendido_por": {
          ".write": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true && data.parent().exists() && !data.exists()",
          ".validate": "newData.isString() && newData.val() === auth.uid && root.child('usuarios_panel').child(auth.uid).val() === true && newData.parent().child('atendido').val() === true"
        },
        "atendido_en": {
          ".write": "auth != null && root.child('usuarios_panel').child(auth.uid).val() === true && data.parent().exists() && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() === now && root.child('usuarios_panel').child(auth.uid).val() === true && newData.parent().child('atendido').val() === true"
        },
        "$otro": { ".validate": false }
      }
    }
  }
}
